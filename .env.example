# Copy to .env and fill in real values:  cp .env.example .env
#
# .env is gitignored. The API image contains no appsettings.json, so these variables
# ARE the configuration. The double underscore is .NET's separator for nested keys:
# ConnectionStrings__DefaultConnection == the "ConnectionStrings:DefaultConnection" setting.
#
# Quote any value containing spaces or a '#'. Compose strips the surrounding quotes; plain
# `docker run --env-file` does not, so start the stack with `docker compose up`.

# ── Database ──────────────────────────────────────────────────────────────────
# Neon (or any hosted Postgres) — note the TLS settings, which a hosted provider needs:
ConnectionStrings__DefaultConnection="Host=YOUR-HOST.neon.tech; Database=neondb; Username=USER; Password=PASSWORD; SSL Mode=VerifyFull; Channel Binding=Require;"
#
# LOCAL_DB — use this form instead once the db service in docker-compose.yml is
# uncommented. "db" is the compose service name; a local container serves no TLS,
# hence SSL Mode=Disable:
# ConnectionStrings__DefaultConnection="Host=db; Port=5432; Database=invitationplatform; Username=invitation; Password=CHANGE_ME; SSL Mode=Disable;"
#
# Used by the (commented) db service itself. Must match the connection string above.
# POSTGRES_USER=invitation
# POSTGRES_PASSWORD=CHANGE_ME

# ── Production rehearsal ──────────────────────────────────────────────────────
# Only read by docker-compose.prod.yml. ":80" serves plain HTTP on this machine, which is
# what you want when rehearsing the production stack locally. On the real server this
# becomes your domain and Caddy obtains a certificate for it.
SITE_ADDRESS=:80

# ── Super Admin ───────────────────────────────────────────────────────────────
# Seeded on first boot if the account does not already exist. Changing the password
# here does NOT change an account that was already created — do that in the admin UI.
SuperAdmin__Email=you@example.com
SuperAdmin__Password=CHANGE_ME
SuperAdmin__FirstName=Super
SuperAdmin__LastName=Admin

# ── Email notifications (optional) ────────────────────────────────────────────
# Demo requests always appear in Admin → Requests with an unread badge, so email is a
# convenience. Leave Smtp__Host empty to disable sending entirely; nothing is lost.
# For Gmail, Smtp__Password must be a 16-character App Password, not the account password.
Smtp__Host=
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__AuthMode=Basic
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=
Smtp__FromName=Invitation Platform
# The internal inbox that receives new-lead alerts. Deliberately separate from the
# landing page's public contact address.
Smtp__NotificationRecipient=
