{
  // This file is COMMITTED — never put real credentials in it.
  //
  // Containers:   values come from .env at the repository root (see backend/docs/DOCKER.md).
  //               The API image ships without this file at all.
  // Local dotnet: use user-secrets, which stay outside the repository:
  //               dotnet user-secrets set "ConnectionStrings:DefaultConnection" "..."
  "ConnectionStrings": {
    "DefaultConnection": "SET_VIA_ENVIRONMENT_OR_USER_SECRETS"
  },
  "Jwt": {
    "Issuer": "InvitationPlatform",
    "Audience": "InvitationPlatform",
    "ExpiryMinutes": 60
  },
  // Bootstrap credentials for the single Super Admin account, created on first boot only.
  // Blank Email skips the seeding entirely (logged as a warning), so leaving these empty is safe.
  "SuperAdmin": {
    "Email": "",
    "Password": "",
    "FirstName": "Super",
    "LastName": "Admin"
  },
  // OPTIONAL email notifications for landing-page demo requests.
  // Requests always appear in Admin -> Requests (with an unread badge), so email is a convenience,
  // not a requirement — leave Host empty and nothing is lost.
  // NotificationRecipient is the internal inbox that receives alerts; it is separate from the
  // landing page's public contact email, so you never have to publish the address you monitor.
  "Smtp": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "AuthMode": "Basic",
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Invitation Platform",
    "NotificationRecipient": ""
  },
  "Storage": {
    "BasePath": "media_storage"
  },
  "Media": {
    "MaxImageBytes": 8388608,
    "MaxVideoBytes": 15728640,
    "MaxAudioBytes": 10485760,
    "MaxImageDimension": 2000,
    "WebpQuality": 80
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
