# PRODUCTION environment — copy to .env ON THE SERVER and fill in.
#
#   cp .env.prod.example .env && nano .env
#
# Every value here is a fresh production secret. Do NOT reuse the local development ones:
# those have been in a tracked file, in shell history, and in chat transcripts.
#
# Quote any value containing spaces or a '#'.

# ── Public address ────────────────────────────────────────────────────────────
# STEP 1 — deploy on the bare IP first, so a failure has one cause instead of three:
SITE_ADDRESS=:80
#
# STEP 2 — once BOTH DNS records resolve to this server, switch to the domain and restart
# caddy. Caddy then requests a Let's Encrypt certificate for each name listed here, so do not
# add www until its record exists, or certificate issuance for it fails on every attempt.
# SITE_ADDRESS=digital-invite.net, www.digital-invite.net
#
# Where Let's Encrypt sends renewal-failure warnings.
ACME_EMAIL=cgteam.ai@outlook.com

# ── Database ──────────────────────────────────────────────────────────────────
# These three are consumed by the db container AND must match the connection string below.
POSTGRES_DB=invitationplatform
POSTGRES_USER=invitation
# Generate, do not invent:  openssl rand -base64 32
POSTGRES_PASSWORD=GENERATE_A_LONG_RANDOM_STRING

# "db" is the compose service name. SSL Mode=Disable is correct here — the connection never
# leaves the private docker network, and the postgres container serves no TLS.
ConnectionStrings__DefaultConnection="Host=db; Port=5432; Database=invitationplatform; Username=invitation; Password=SAME_AS_POSTGRES_PASSWORD_ABOVE; SSL Mode=Disable;"

# ── Super Admin ───────────────────────────────────────────────────────────────
# Seeded on first boot only. Changing this later does NOT update an existing account —
# use the admin UI for that. Never reuse the local development password here.
SuperAdmin__Email=you@yourdomain.com
SuperAdmin__Password=GENERATE_A_STRONG_PASSWORD
SuperAdmin__FirstName=Super
SuperAdmin__LastName=Admin

# ── Email notifications (optional) ────────────────────────────────────────────
# Demo requests are always stored and shown in Admin → Requests with an unread badge,
# so leaving Host empty loses no leads — it only disables the email alert.
# Use a NEW Gmail App Password; the development one should be revoked.
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__AuthMode=Basic
Smtp__Username=you@gmail.com
Smtp__Password="xxxx xxxx xxxx xxxx"
Smtp__FromAddress=you@gmail.com
Smtp__FromName="Invitation Platform"
Smtp__NotificationRecipient=you@yourdomain.com

# ── Hardening (set once the domain is live) ───────────────────────────────────
# Rejects requests carrying an unexpected Host header. Leave as * while running on a bare IP,
# then switch to the domain list — semicolon-separated, no scheme.
AllowedHosts=*
# AllowedHosts=digital-invite.net;www.digital-invite.net

# Cross-origin access. Leave EMPTY: the frontend is served from the same origin, so no CORS
# grant is needed. Only set this if you ever host the frontend on a different domain.
# Cors__AllowedOrigins__0=https://digital-invite.net
